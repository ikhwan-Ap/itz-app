# itz-app Frontend — Environment Variables
# Copy file ini ke .env (React butuh .env di folder frontend/)
# JANGAN commit .env ke git!

# ===== Backend API =====
# URL backend yang dipanggil oleh axios (lib/api.js)
# Dev: http://localhost:8000
# Prod: https://indotimezone.store
REACT_APP_BACKEND_URL=https://indotimezone.store

# ===== CRA Build Tweaks =====
# Skip preflight check antara React dan react-scripts/ajv versions
SKIP_PREFLIGHT_CHECK=true

# ===== Optional — Development Only =====
# Port dev server (default 3000)
# PORT=3000
# BROWSER=none  # jangan auto-open browser
