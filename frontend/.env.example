# ITZ-App Frontend — Environment Variables
# Copy ke .env lalu isi nilainya
# JANGAN commit file .env ke git!

# URL backend API (tanpa trailing slash)
# Development: http://localhost:8000
# Production:  https://indotimezone.store
REACT_APP_BACKEND_URL=https://indotimezone.store

# Skip CRA preflight check (set true jika ada konflik dependency)
SKIP_PREFLIGHT_CHECK=true
