# itz-app Backend — Environment Variables
# Copy file ini ke .env lalu isi semua nilainya
# JANGAN commit file .env ke git!

# ===== App =====
APP_ENV=production

# ===== MongoDB =====
MONGO_URL=mongodb://localhost:27017
DB_NAME=itz_app

# ===== JWT =====
# Generate dengan: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=ganti_dengan_random_string_panjang_minimal_64_karakter

# ===== CORS & Cookie =====
# URL frontend production (untuk CORS + cookie SameSite)
FRONTEND_URL=https://indotimezone.store
CORS_ORIGINS=https://indotimezone.store,https://www.indotimezone.store

# ===== Superadmin Seed =====
# Dipakai saat startup untuk seed akun superadmin pertama kali
# Setelah seed berhasil, nilai ini tidak dipakai lagi (tidak bisa login via env)
ADMIN_EMAIL=superadmin@indotimezone.store
ADMIN_PASSWORD=GantiPasswordIniSekarang!

# ===== Uvicorn Workers =====
# 1 worker untuk VPS kecil (512MB-1GB RAM)
# 2 workers untuk VPS >= 2GB RAM
# Diset di /etc/systemd/system/itz-backend.service, bukan di sini
# ExecStart=...uvicorn server:app --host 0.0.0.0 --port 8000 --workers 1
